# Telegram bot token from @BotFather
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_FROM_BOTFATHER_HERE

# Comma-separated Telegram user IDs allowed to use admin commands
# Get your own ID from @userinfobot on Telegram
ADMIN_IDS=111111111,222222222

# Free API key from https://newsapi.org (used for Forex News feature)
NEWS_API_KEY=your_newsapi_key_here

# SQLite database file path (Railway: leave as default, it's ephemeral unless you add a volume)
DATABASE_PATH=forextrend.db

# Hour/minute (UTC, 24h) for the automatic daily update broadcast
DAILY_UPDATE_HOUR=8
DAILY_UPDATE_MINUTE=0
